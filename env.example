# =============================================================================
# LLM API Keys
# =============================================================================
# Copy to .env and fill in actual values.
# Never commit .env to version control.
# =============================================================================

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI (direct)
OPENAI_API_KEY=sk-proj-...

# Azure OpenAI
AZURE_SEA_API_KEY=
AZURE_AUE_API_KEY=

# DeepSeek (single global endpoint, mainland China infrastructure)
DEEPSEEK_API_KEY=sk-...

# MiniMax (Beijing-based, OpenAI-compatible API)
MINIMAX_API_KEY=eyJ...

# Z.AI / Zhipu (Beijing-based, OpenAI-compatible API)
Z_AI_API_KEY=...

# llm-router-ledger run tagging
# Stamped on every JSONL event for grouping / filtering.
# LRL_RUN_TAG: short identifier, e.g. R149 (matches the run tracker).
# LRL_RUN_LABEL: human-readable description, e.g. "GLM-4.7 temp=0 run 3".
LRL_RUN_TAG=
LRL_RUN_LABEL=

# Alibaba Cloud DashScope (Qwen)
# Keys are region-specific and NOT interchangeable.
# Each requires its own Alibaba Cloud account for that region.
DASHSCOPE_INTL_API_KEY=sk-...    # International (Singapore)
DASHSCOPE_CN_API_KEY=sk-...      # Chinese Mainland (Beijing)
DASHSCOPE_HK_API_KEY=sk-...      # China (Hong Kong)
